    {
      "name": "03 - Fluxo 1 — Consulta clínica assistida",
      "description": "Sequência principal para VETERINARIO: criar a consulta, iniciar, registrar narrativa, solicitar e consultar apoio clínico provisório e finalizar com a conclusão do veterinário. O cancelamento é uma alternativa e não deve ser executado na mesma sequência.",
      "item": [
        {
          "name": "01 POST Criar consulta (AG)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json",
                "type": "text"
